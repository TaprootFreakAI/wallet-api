{
  "schema": "a38/v1",
  "standard": "A38",
  "documentation": "docs/a38.md",
  "mode": "enforce",
  "jobs": [
    {
      "id": "format",
      "name": "Format",
      "timeout_s": 300,
      "workflow": ".github/workflows/wallet-api-ci.yml",
      "job": "format",
      "executor": {
        "adapter": "commands",
        "config": {
          "env": {
            "CI": "true"
          },
          "npm": {
            "node_major": 24,
            "canaries": [
              "@nestjs/core/package.json",
              "typescript/lib/typescript.js",
              "jest/bin/jest.js",
              "prettier/package.json"
            ]
          },
          "steps": [["npm", "run", "format:check"]]
        }
      }
    },
    {
      "id": "lint",
      "name": "Lint",
      "timeout_s": 600,
      "workflow": ".github/workflows/wallet-api-ci.yml",
      "job": "lint",
      "executor": {
        "adapter": "commands",
        "config": {
          "env": {
            "CI": "true"
          },
          "npm": {
            "node_major": 24,
            "canaries": [
              "@nestjs/core/package.json",
              "typescript/lib/typescript.js",
              "jest/bin/jest.js",
              "prettier/package.json"
            ]
          },
          "steps": [["npm", "run", "lint"]]
        }
      }
    },
    {
      "id": "build",
      "name": "Build",
      "timeout_s": 600,
      "workflow": ".github/workflows/wallet-api-ci.yml",
      "job": "build",
      "executor": {
        "adapter": "commands",
        "config": {
          "env": {
            "CI": "true"
          },
          "npm": {
            "node_major": 24,
            "canaries": [
              "@nestjs/core/package.json",
              "typescript/lib/typescript.js",
              "jest/bin/jest.js",
              "prettier/package.json"
            ]
          },
          "steps": [["npm", "run", "build"]]
        }
      }
    },
    {
      "id": "test",
      "name": "Test",
      "timeout_s": 900,
      "workflow": ".github/workflows/wallet-api-ci.yml",
      "job": "test",
      "executor": {
        "adapter": "commands",
        "config": {
          "env": {
            "CI": "true",
            "ENVIRONMENT": "loc",
            "WALLET_SESSION_SECRET": "wallet-api-ci-test-secret-32-characters"
          },
          "npm": {
            "node_major": 24,
            "canaries": [
              "@nestjs/core/package.json",
              "typescript/lib/typescript.js",
              "jest/bin/jest.js",
              "prettier/package.json"
            ]
          },
          "steps": [["npm", "test"]]
        }
      }
    }
  ],
  "exclusions": [
    {
      "workflow": ".github/workflows/a38-guard.yml",
      "job": "guard",
      "reason": "Reconciles review and CI evidence for the pull request. It is not an author test."
    },
    {
      "workflow": ".github/workflows/ensure-branches.yml",
      "job": "ensure",
      "reason": "Creates the develop and staging refs when they are absent. It is housekeeping, not an author test."
    },
    {
      "workflow": ".github/workflows/auto-release-pr.yaml",
      "job": "create-release-pr",
      "reason": "Opens a draft pull request from develop to main. It is not an author test."
    },
    {
      "workflow": ".github/workflows/release-pr-author.yml",
      "job": "bot-author",
      "reason": "Checks that pull requests into main are opened by github-actions[bot]. It is not an author test."
    },
    {
      "workflow": ".github/workflows/wallet-api-dev.yml",
      "job": "build-and-push",
      "reason": "Publishes the develop container image by its commit SHA. It is not an author test."
    },
    {
      "workflow": ".github/workflows/wallet-api-dev.yml",
      "job": "promote",
      "reason": "Points the beta tag at the image of the current develop head. It is not an author test."
    },
    {
      "workflow": ".github/workflows/wallet-api-stg.yml",
      "job": "build-and-push",
      "reason": "Publishes the staging container image by its commit SHA. It is not an author test."
    },
    {
      "workflow": ".github/workflows/wallet-api-stg.yml",
      "job": "promote",
      "reason": "Points the stg tag at the image of the current staging head. It is not an author test."
    },
    {
      "workflow": ".github/workflows/wallet-api-prd.yml",
      "job": "build-and-push",
      "reason": "Publishes the production container image by its commit SHA. It is not an author test."
    },
    {
      "workflow": ".github/workflows/wallet-api-prd.yml",
      "job": "promote",
      "reason": "Points the latest tag at the image of the current main head. It is not an author test."
    },
    {
      "workflow": ".github/workflows/main-from-develop.yml",
      "job": "only-develop",
      "reason": "Checks that pull requests into main come from develop. It is not an author test."
    },
    {
      "workflow": ".github/workflows/staging-from-main.yml",
      "job": "fast-forward",
      "reason": "Fast-forwards staging to every new main head and starts the STG build. It is housekeeping, not an author test."
    }
  ]
}
